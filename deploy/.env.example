# deploy/.env.example — template only; real values come from
# scripts/generate-secrets.sh into gitignored deploy/.env. Never commit secrets.

# --- Database (PostgreSQL everywhere; drizzle-orm/bun-sql) ---
# Password for the compose `db` service (postgres:17-alpine). Required;
# compose refuses to start without it.
POSTGRES_PASSWORD=
# PostgreSQL connection URL. Compose builds it from POSTGRES_PASSWORD
# (postgres://hoborouter:${POSTGRES_PASSWORD}@db:5432/hoborouter); set this
# only when running outside compose.
DATABASE_URL=
# Deployed image tag for ghcr.io/teppyboy/hoborouter (compose default: latest).
HBR_IMAGE_TAG=

# --- Secrets (generated by scripts/generate-secrets.sh) ---
# CPA management key (web UI / management API)
CPA_MANAGEMENT_KEY=
# CPA access key (upstream proxy auth)
CPA_ACCESS_KEY=
# Better Auth signing secret (openssl rand -hex 32)
# Required (min 32 chars) when NODE_ENV=production. AUTH_SECRET also accepted.
BETTER_AUTH_SECRET=

# --- Core ---
# Public base URL of this instance (required when NODE_ENV=production).
BETTER_AUTH_URL=
# Base URL CPA is reachable at from the api container.
# In compose this is set by docker-compose.yml; override here to change it.
CPA_BASE_URL=
# Public base URL (fallback for BETTER_AUTH_URL).
HBR_BASE_URL=
# Extra origins (comma-separated) accepted by Better Auth.
HBR_TRUSTED_ORIGINS=
# 0 = disable paid gateway routes (default ON).
HBR_GATEWAY_ENABLED=1
# API server idle timeout in seconds (1–255, default 255). Bun's 10 s default
# would cut streaming responses that pause between chunks.
HBR_IDLE_TIMEOUT_S=
# Directory for uploaded account avatars. In the image the default is
# /data/avatars (set by the Dockerfile); outside it defaults to ./data/avatars.
HBR_AVATAR_DIR=
# Web build directory override (defaults to apps/web/dist).
HBR_WEB_DIST=

# --- Gateway / billing ---
HBR_USD_VND_RATE=26000
HBR_DEFAULT_MAX_OUTPUT_TOKENS=4096

# --- Payments: top-ups are provider "manual" in every environment ---
# Members create a pending manual top-up; an INSTANCE ADMIN marks it paid
# (Admin → Payments). Manual works with no payment env at all.
# payOS is enabled only when ALL THREE credentials below are set (from the
# payOS dashboard); any one missing leaves payOS off and manual the only
# method. These are secrets: keep them in this gitignored file only — never
# in the repo, logs, or API responses (the API advertises payOS as a mere
# boolean via /api/v1/payment-methods).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# The webhook route /webhooks/payments/payos goes live automatically with the
# three vars above (404 while unset); its public URL is configured in the
# payOS dashboard, not here. Return/cancel redirects are built from
# BETTER_AUTH_URL / HBR_BASE_URL (Core section) — set that to the public
# HTTPS URL before enabling payOS. Full setup: docs/deployment.md.
# Legacy compatibility only: gates the legacy signed mock webhook route.
# Empty/'on' = route enabled when its key is set; 'off' disables.
HBR_MOCK_PAYMENTS=
# Non-empty key enables the legacy signed mock webhook (/webhooks/payments/mock).
HBR_MOCK_PAYMENTS_WEBHOOK_KEY=

# --- Admin bootstrap ---
# Dev-only: signup with this email auto-grants instance admin when
# NODE_ENV is development/test (see apps/api/src/auth.ts).
HBR_DEV_ADMIN_EMAIL=
# First admin; signs up with this email; ignored once an admin exists.
HBR_BOOTSTRAP_INSTANCE_ADMIN_EMAIL=

# --- Cloudflare Turnstile (optional bot protection, off by default) ---
# Widget site key, read at RUNTIME from TURNSTILE_SITE_KEY and published to
# the SPA via /api/v1/public-config (public by design). VITE_TURNSTILE_SITE_KEY
# is a legacy fallback for older web builds that baked the key in at build
# time; prefer TURNSTILE_SITE_KEY. The widget is skipped on localhost.
# Test site key (always passes): 1x00000000000000000000AA
TURNSTILE_SITE_KEY=
# Legacy build-time site key; only read when TURNSTILE_SITE_KEY is empty.
VITE_TURNSTILE_SITE_KEY=
# API secret key; enables Turnstile verification on sign-in/sign-up when set.
# The secret never leaves the server. Fail-closed: if the secret is set but no
# site key is configured, /api/v1/public-config answers 503 instead of
# silently dropping the protection.
# Test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Email verification (optional; plain SMTP, off by default) ---
# Enabled only when BOTH SMTP_HOST and HBR_EMAIL_FROM are set. There is no
# third-party email provider integration (no Resend etc.) — a minimal SMTP
# client (node:net/node:tls) with AUTH PLAIN/LOGIN and STARTTLS/implicit SSL.
# Verification is a notification, never a gate: unverified users can sign in
# normally (no strict-mode variable exists).
# SMTP server hostname.
SMTP_HOST=
# SMTP port (default 587; when left unset, port 465 switches the security
# mode below to `ssl`).
SMTP_PORT=
# AUTH credentials; both must be set together or both omitted (no AUTH).
SMTP_USER=
SMTP_PASSWORD=
# Transport security: `starttls` (default; mandatory — the send fails before
# AUTH if the server does not offer STARTTLS), `ssl` (implicit TLS from the
# first byte, e.g. port 465), or `none` (cleartext, DEV/LOCAL TESTING ONLY —
# refused at startup of a send when NODE_ENV=production).
HBR_SMTP_SECURE=
# From address: bare (`no-reply@example.com`) or display form
# (`Hoborouter <no-reply@example.com>`). The envelope MAIL FROM uses the bare
# address. Required together with SMTP_HOST for verification mail.
HBR_EMAIL_FROM=
# Sender reputation: configure SPF and DKIM DNS records for the sending
# domain, or verification mail is likely junked/rejected by recipients.
