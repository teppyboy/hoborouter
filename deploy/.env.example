# deploy/.env.example — template only; real values come from
# scripts/generate-secrets.sh into gitignored deploy/.env. Never commit secrets.

# --- Database (PostgreSQL everywhere; drizzle-orm/bun-sql) ---
# Password for the compose `db` service (postgres:17-alpine). Required;
# compose refuses to start without it.
POSTGRES_PASSWORD=
# PostgreSQL connection URL. Compose builds it from POSTGRES_PASSWORD
# (postgres://hoborouter:${POSTGRES_PASSWORD}@db:5432/hoborouter); set this
# only when running outside compose.
DATABASE_URL=
# Deployed image tag for ghcr.io/teppyboy/hoborouter (compose default: latest).
HBR_IMAGE_TAG=

# --- Secrets (generated by scripts/generate-secrets.sh) ---
# CPA management key (web UI / management API)
CPA_MANAGEMENT_KEY=
# CPA access key (upstream proxy auth)
CPA_ACCESS_KEY=
# Better Auth signing secret (openssl rand -hex 32)
# Required (min 32 chars) when NODE_ENV=production. AUTH_SECRET also accepted.
BETTER_AUTH_SECRET=

# --- Core ---
# Public base URL of this instance (required when NODE_ENV=production).
BETTER_AUTH_URL=
# Base URL CPA is reachable at from the api container.
# In compose this is set by docker-compose.yml; override here to change it.
CPA_BASE_URL=
# Public base URL (fallback for BETTER_AUTH_URL).
HBR_BASE_URL=
# Extra origins (comma-separated) accepted by Better Auth.
HBR_TRUSTED_ORIGINS=
# 0 = disable paid gateway routes (default ON).
HBR_GATEWAY_ENABLED=1
# API server idle timeout in seconds (1–255, default 255). Bun's 10 s default
# would cut streaming responses that pause between chunks.
HBR_IDLE_TIMEOUT_S=
# Directory for uploaded account avatars. In the image the default is
# /data/avatars (set by the Dockerfile); outside it defaults to ./data/avatars.
HBR_AVATAR_DIR=
# Web build directory override (defaults to apps/web/dist).
HBR_WEB_DIST=

# --- Gateway / billing ---
HBR_USD_VND_RATE=26000
HBR_DEFAULT_MAX_OUTPUT_TOKENS=4096

# --- Payments: top-ups are provider "manual" in every environment ---
# Members create a pending manual top-up; an INSTANCE ADMIN marks it paid
# (Admin → Payments). payOS is optional when all three are set.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Legacy compatibility only: gates the legacy signed mock webhook route.
# Empty/'on' = route enabled when its key is set; 'off' disables.
HBR_MOCK_PAYMENTS=
# Non-empty key enables the legacy signed mock webhook (/webhooks/payments/mock).
HBR_MOCK_PAYMENTS_WEBHOOK_KEY=

# --- Admin bootstrap ---
# Dev-only: signup with this email auto-grants instance admin when
# NODE_ENV is development/test (see apps/api/src/auth.ts).
HBR_DEV_ADMIN_EMAIL=
# First admin; signs up with this email; ignored once an admin exists.
HBR_BOOTSTRAP_INSTANCE_ADMIN_EMAIL=

# --- Cloudflare Turnstile (optional bot protection, off by default) ---
# Frontend widget site key (build-time for the web image). Empty = disabled.
# Skipped automatically on localhost. Test site key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# API secret key; enables Turnstile verification on sign-in/sign-up when set.
# Test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
