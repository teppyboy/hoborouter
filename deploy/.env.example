# deploy/.env.example — template only; real values come from
# scripts/generate-secrets.sh into gitignored deploy/.env. Never commit secrets.

# --- Secrets (generated by scripts/generate-secrets.sh) ---
# CPA management key (web UI / management API)
CPA_MANAGEMENT_KEY=
# CPA access key (upstream proxy auth)
CPA_ACCESS_KEY=
# Better Auth signing secret (openssl rand -hex 32)
# Required (min 32 chars) when NODE_ENV=production. AUTH_SECRET also accepted.
BETTER_AUTH_SECRET=

# --- Core ---
# Public base URL of this instance (required when NODE_ENV=production).
BETTER_AUTH_URL=
# Base URL CPA is reachable at from the api container.
# In compose this is http://cpa:8317 (set in docker-compose.yml).
CPA_BASE_URL=
# Public base URL (fallback for BETTER_AUTH_URL).
HBR_BASE_URL=
# SQLite database path. Compose sets /data/hoborouter.db.
HBR_DB_PATH=
# 0 = disable paid gateway routes (default ON).
HBR_GATEWAY_ENABLED=1

# --- Gateway / billing ---
HBR_USD_VND_RATE=26000
HBR_DEFAULT_MAX_OUTPUT_TOKENS=4096

# --- Payments (mock provider is the default; payOS optional when all three set) ---
# All three required for payOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# --- Payments: dev-only self-completion ---
# /api/dev/payments/:id/complete exists ONLY when NODE_ENV is 'development' or
# 'test' AND HBR_DEV_PAYMENTS=1. Run dev with NODE_ENV=development. Never set
# in production; use
# POST /api/admin/payments/:id/complete (instance admin) there.
HBR_DEV_PAYMENTS=

# --- Mock payments (default top-up provider) ---
# Mock top-up creation is ON by default; set to 'off' to disable.
# The signed mock webhook is optional — enabled only when its key is set.
HBR_MOCK_PAYMENTS=
HBR_MOCK_PAYMENTS_WEBHOOK_KEY=

# --- Optional bootstrap ---
# Email of the initial instance admin (see scripts/bootstrap-instance-admin.ts).
HBR_BOOTSTRAP_INSTANCE_ADMIN_EMAIL=

# --- Cloudflare Turnstile (optional bot protection, off by default) ---
# Frontend widget site key (build-time for the web image). Empty = disabled.
# Skipped automatically on localhost. Test site key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# API secret key; enables Turnstile verification on sign-in/sign-up when set.
# Test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Legal pages (build-time for the web image) ---
VITE_LEGAL_OPERATOR_NAME=Hoborouter Team
VITE_LEGAL_CONTACT_EMAIL=hoborouter@june8th.me
VITE_LEGAL_EFFECTIVE_DATE=2026-10-02
