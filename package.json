{
  "name": "hoborouter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "test": "vp run bun-test",
    "bun-test": "bun test --parallel=4",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "dev": "bash scripts/dev.sh",
    "e2e": "bash tests/e2e/stack.sh up && bun tests/e2e/ui.ts; s=$?; bash tests/e2e/stack.sh down; exit $s",
    "e2e:up": "bash tests/e2e/stack.sh up",
    "e2e:down": "bash tests/e2e/stack.sh down",
    "build": "vp build"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@types/node": "^26.6.3",
    "typescript": "~6.0.2",
    "vite-plus": "1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
